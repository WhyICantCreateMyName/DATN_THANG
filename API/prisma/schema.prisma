generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  password          String
  fullName          String
  role              Role
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  ordersCreated     Order[]            @relation("WaiterOrders")
  stockTransactions StockTransaction[]
}

model Customer {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id           String        @id @default(uuid())
  name         String        @unique
  capacity     Int
  status       TableStatus   @default(AVAILABLE)
  qrCode       String?       @unique
  orders       Order[]
  reservations Reservation[]
  chatSessions ChatSession[]
  invoices     Invoice[]
}

model Reservation {
  id              String            @id @default(uuid())
  customerName    String
  phone           String
  reservationTime DateTime
  guestCount      Int
  status          ReservationStatus @default(PENDING)
  tableId         String
  table           Table             @relation(fields: [tableId], references: [id])
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  menuItems MenuItem[]
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  ingredients MenuItemIngredient[]
}

model MenuItemIngredient {
  id           String     @id @default(uuid())
  menuItemId   String
  ingredientId String
  quantity     Float      // Lượng tiêu hao (g, ml, cái, v.v.)
  
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId])
}

model Order {
  id             String      @id @default(uuid())
  status         OrderStatus @default(PENDING)
  totalAmount    Float       @default(0)
  discountAmount Float       @default(0)
  voucherCode    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tableId        String
  customerPhone  String?
  waiterId       String?
  chatSessionId  String?
  invoiceId      String?
  invoice        Invoice?    @relation(fields: [invoiceId], references: [id])
  table          Table       @relation(fields: [tableId], references: [id])
  waiter         User?       @relation("WaiterOrders", fields: [waiterId], references: [id])
  chatSession    ChatSession? @relation(fields: [chatSessionId], references: [id])
  items          OrderItem[]
}

model OrderItem {
  id          String          @id @default(uuid())
  quantity    Int
  priceAtTime Float
  notes       String?
  status      OrderItemStatus @default(PENDING)
  orderId     String
  menuItemId  String
  menuItem    MenuItem        @relation(fields: [menuItemId], references: [id])
  order       Order           @relation(fields: [orderId], references: [id])
}

model Invoice {
  id          String    @id @default(uuid())
  subTotal    Float
  tax         Float     @default(0)
  discount    Float     @default(0)
  finalAmount Float
  isPaid      Boolean   @default(true)
  issuedAt    DateTime  @default(now())

  tableId     String
  table       Table     @relation(fields: [tableId], references: [id])

  chatSessionId String?
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id])

  orders      Order[]
  payments    Payment[]
}

model Payment {
  id        String        @id @default(uuid())
  amount    Float
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
}

model Supplier {
  id           String             @id @default(uuid())
  name         String
  contact      String?
  address      String?
  createdAt    DateTime           @default(now())
  transactions StockTransaction[]
}

model Ingredient {
  id           String             @id @default(uuid())
  name         String
  unit         String
  currentStock Float              @default(0)
  minStock     Float              @default(5)
  transactions StockTransaction[]
  menuItems    MenuItemIngredient[]
}

model StockTransaction {
  id           String          @id @default(uuid())
  type         TransactionType
  quantity     Float
  note         String?
  createdAt    DateTime        @default(now())
  ingredientId String
  userId       String
  supplierId   String?
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
}

model Voucher {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(FIXED)
  discountValue Float        // Giá trị giảm (tiền mặt hoặc %)
  maxDiscount   Float?       // Giảm tối đa (cho loại %)
  minOrderValue Float        @default(0) // Giá trị đơn tối thiểu để áp dụng
  
  usageLimit           Int?         // Tổng số lượt sử dụng tối đa (null = vô hạn)
  usedCount            Int          @default(0)
  maxUsagePerCustomer  Int?         // Số lần tối đa 1 khách được dùng (null = vô hạn)
  
  isActive      Boolean      @default(true)
  startDate     DateTime?
  endDate       DateTime?
  
  // Lưu các điều kiện dưới dạng JSON
  // Ví dụ: { "type": "ORDER_COUNT", "min": 5 }
  // Hoặc: { "type": "NEW_USER" }
  conditions    Json?        @default("[]")
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum Role {
  ADMIN
  KITCHEN
  CASHIER
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
}

enum OrderStatus {
  PENDING
  COOKING
  READY
  SERVED
  COMPLETED
  CANCELLED
  WAITING_APPROVAL
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  E_WALLET
}

enum TransactionType {
  IMPORT
  EXPORT
  AUDIT_START
  AUDIT_END
}

enum OrderItemStatus {
  PENDING
  COOKING
  READY
  SERVED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

// ==========================================
// MODULE: CHAT REAL-TIME (ẨN DANH & RESET PHIÊN)
// ==========================================

// Quản lý Phiên Chat theo từng lượt khách
model ChatSession {
  id        String    @id @default(uuid())
  
  // Trạng thái Phiên: 
  // - True: Đang mở (Khách đang ăn).
  // - False: Đã thanh toán, khóa phiên lại.
  isActive  Boolean   @default(true) 
  
  startTime DateTime  @default(now())
  endTime   DateTime?
 
  tableId   String
  table     Table     @relation(fields: [tableId], references: [id])
  
  messages  Message[]
  orders    Order[]
  invoices  Invoice[]
}

enum SenderType {
  CUSTOMER
  STAFF
}

// Lưu trữ tin nhắn (Hoàn toàn ẩn danh với khách)
model Message {
  id            String      @id @default(uuid())
  content       String      @db.Text
  
  senderType    SenderType
  
  // Nơi chứa "Căn cước ẩn danh":
  // - Nếu là Khách: Lưu cái mã `guestId` sinh ra từ JWT (VD: "guest_x8f9a")
  // - Nếu là Nhân viên: Lưu ID của tài khoản nhân viên (VD: "user_123")
  senderId      String      
  
  createdAt     DateTime    @default(now())
  
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
}