generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  password          String
  fullName          String
  role              Role
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  ordersCreated     Order[]            @relation("WaiterOrders")
  stockTransactions StockTransaction[]
}

model Customer {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id           String        @id @default(uuid())
  name         String        @unique
  capacity     Int
  status       TableStatus   @default(AVAILABLE)
  qrCode       String?       @unique
  chatSessions ChatSession[]
  invoices     Invoice[]
  orders       Order[]
  reservations Reservation[]
}

model Reservation {
  id              String            @id @default(uuid())
  customerName    String
  reservationTime DateTime
  tableId         String?
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  customerPhone   String
  guests          Int
  note            String?
  updatedAt       DateTime          @updatedAt
  table           Table?            @relation(fields: [tableId], references: [id])
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  menuItems MenuItem[]
}

model MenuItem {
  id          String               @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean              @default(true)
  categoryId  String
  category    Category             @relation(fields: [categoryId], references: [id])
  ingredients MenuItemIngredient[]
  orderItems  OrderItem[]
}

model MenuItemIngredient {
  id           String     @id @default(uuid())
  menuItemId   String
  ingredientId String
  quantity     Float
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])

  @@unique([menuItemId, ingredientId])
}

model Order {
  id             String       @id @default(uuid())
  status         OrderStatus  @default(PENDING)
  totalAmount    Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tableId        String
  waiterId       String?
  chatSessionId  String?
  invoiceId      String?
  discountAmount Float        @default(0)
  voucherCode    String?
  customerPhone  String?
  chatSession    ChatSession? @relation(fields: [chatSessionId], references: [id])
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  table          Table        @relation(fields: [tableId], references: [id])
  waiter         User?        @relation("WaiterOrders", fields: [waiterId], references: [id])
  items          OrderItem[]
}

model OrderItem {
  id          String          @id @default(uuid())
  quantity    Int
  priceAtTime Float
  notes       String?
  orderId     String
  menuItemId  String
  status      OrderItemStatus @default(PENDING)
  menuItem    MenuItem        @relation(fields: [menuItemId], references: [id])
  order       Order           @relation(fields: [orderId], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  subTotal      Float
  tax           Float         @default(0)
  discount      Float         @default(0)
  finalAmount   Float
  isPaid        Boolean       @default(false)
  issuedAt      DateTime      @default(now())
  tableId       String
  chatSessionId String?
  paymentMethod PaymentMethod @default(CASH)
  chatSession   ChatSession?  @relation(fields: [chatSessionId], references: [id])
  table         Table         @relation(fields: [tableId], references: [id])
  orders        Order[]
  payments      Payment[]
}

model Payment {
  id                 String        @id @default(uuid())
  amount             Float
  method             PaymentMethod
  paidAt             DateTime      @default(now())
  invoiceId          String
  vnpayTransactionNo String?
  invoice            Invoice       @relation(fields: [invoiceId], references: [id])
}

model Supplier {
  id           String             @id @default(uuid())
  name         String
  contact      String?
  address      String?
  createdAt    DateTime           @default(now())
  transactions StockTransaction[]
}

model Ingredient {
  id           String               @id @default(uuid())
  name         String
  unit         String
  currentStock Float                @default(0)
  minStock     Float                @default(5)
  menuItems    MenuItemIngredient[]
  transactions StockTransaction[]
}

model StockTransaction {
  id           String          @id @default(uuid())
  type         TransactionType
  quantity     Float
  note         String?
  createdAt    DateTime        @default(now())
  ingredientId String
  userId       String
  supplierId   String?
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id])
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
}

model Voucher {
  id                  String       @id @default(uuid())
  code                String       @unique
  description         String?
  discountType        DiscountType @default(FIXED)
  discountValue       Float
  maxDiscount         Float?
  minOrderValue       Float        @default(0)
  usageLimit          Int?
  usedCount           Int          @default(0)
  isActive            Boolean      @default(true)
  startDate           DateTime?
  endDate             DateTime?
  conditions          Json?        @default("[]")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  maxUsagePerCustomer Int?
}

model ChatSession {
  id        String    @id @default(uuid())
  isActive  Boolean   @default(true)
  startTime DateTime  @default(now())
  endTime   DateTime?
  tableId   String
  table     Table     @relation(fields: [tableId], references: [id])
  invoices  Invoice[]
  messages  Message[]
  orders    Order[]
}

model Message {
  id            String      @id @default(uuid())
  content       String
  senderType    SenderType
  senderId      String
  createdAt     DateTime    @default(now())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
}

enum Role {
  ADMIN
  KITCHEN
  CASHIER
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
}

enum OrderStatus {
  PENDING
  COOKING
  READY
  SERVED
  COMPLETED
  CANCELLED
  WAITING_APPROVAL
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  VNPAY
  MOMO
}

enum TransactionType {
  IMPORT
  EXPORT
  AUDIT_START
  AUDIT_END
}

enum OrderItemStatus {
  PENDING
  COOKING
  READY
  SERVED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  ARRIVED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum SenderType {
  CUSTOMER
  STAFF
}
